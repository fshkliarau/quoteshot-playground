{
  "name": "quoteshot-playground",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "build": "expo export --platform web --output-dir dist",
    "build:pages": "EXPO_BASE_URL=/quoteshot-playground expo export --platform web --output-dir dist",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/albert-sans": "^0.2.3",
    "@expo-google-fonts/geist-mono": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/source-serif-4": "^0.2.3",
    "@expo/metro-runtime": "~4.0.1",
    "dialkit": "^1.2.1",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-font": "~13.0.4",
    "expo-linear-gradient": "~14.0.2",
    "expo-status-bar": "~2.0.1",
    "html-to-image": "^1.11.13",
    "motion": "^12.40.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "patch-package": "^8.0.1"
  }
}
